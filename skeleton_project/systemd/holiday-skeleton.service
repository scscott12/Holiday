[Unit]
Description=Holiday Skeleton Runtime Service
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=scscott
Group=scscott
StateDirectory=holiday-skeleton
StateDirectoryMode=0750
RuntimeDirectory=holiday-skeleton
RuntimeDirectoryMode=0750
WorkingDirectory=/run/holiday-skeleton
ExecStart=/opt/holiday-skeleton/current/venv/bin/python /opt/holiday-skeleton/current/skeleton_all_in_one_mqtt.py
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=20
WatchdogSec=60
Environment=PYTHONUNBUFFERED=1
Environment=LG_WD=/run/holiday-skeleton
SupplementaryGroups=gpio i2c audio video

[Install]
WantedBy=multi-user.target
